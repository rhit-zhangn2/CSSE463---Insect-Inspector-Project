createSVM_wrapper("LST_Shape_SVM.mat", [X_shape_Train, X_LST_Train], Y_Train, "Combined LST Shape", fresh, iterations); 
createSVM_wrapper("HOG_Shape_SVM.mat", [X_shape_Train, X_HOG_Train], Y_Train, "Combined HOG Shape", fresh, iterations); 

createSVM_wrapper("LST_HOG_Shape_SVM.mat", [X_shape_Train, X_LST_Train, X_HOG_Train], Y_Train, "Combined LST HOG Shape", fresh, iterations); 




